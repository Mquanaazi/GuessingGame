<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuessingGame.SliderDemoPage"
             
             Title="SliderDemoPage">
    
    <VerticalStackLayout Spacing="25">
        <Label x:Name="SlideMeLabel"
            Text="Slide Me!" FontAttributes="Bold" FontSize="40" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Slider x:Name="DemoSlider" ValueChanged="Slider_ValueChanged"/>
        <Label x:Name="SliderValueLabel" Text="0" FontAttributes="Bold" FontSize="40" HorizontalTextAlignment="Center"/>
    
    </VerticalStackLayout>
</ContentPage>